<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification alert (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service (required API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Foreground service type: specialUse — keeps the rest timer alive during a workout (required API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Timer vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Health Connect: read-only recovery signals (sleep, resting HR) feed the coach. These are
         on-device permissions granted via the Health Connect app; Forge holds NO internet permission,
         so the data never leaves the device. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <!-- Bodyweight sync (HC-2/HC-3): read a smart-scale value INTO Forge, write a Forge weigh-in
         BACK. Both opt-in and granted in the Health Connect app; still no internet permission. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <!-- Steps: read a watch/ring's daily step counts INTO Forge for the cardio screen's hourly-steps
         graph. Read-only, opt-in, granted in the Health Connect app; still no internet permission. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Exercise sessions: read a watch's recorded outdoor sessions so Forge can find the GPS route
         that matches a cardio entry. The route data itself is released per-session via Health Connect's
         own consent screen (ExerciseRouteRequestContract) — there is no blanket route-read permission.
         Read-only, opt-in; still no internet permission. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Workout calories (HC-4): write a finished session's estimated active calories OUT to Health
         Connect's daily energy total. Without this the write permission can never be granted. -->
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />

    <!-- Lets us detect / launch the Health Connect provider to check availability + manage grants. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ForgeApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Forge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Forge.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect permission rationale (Android 13 and below): HC opens this when the
                 user taps "why does this app want my data". We just bring up Forge. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- Import from another gym app (#GYMAP-17): accept a shared/opened CSV or JSON export so
                 "Export → Share → Avex" imports directly, no file browsing. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission rationale (Android 14+): same purpose, framework-routed. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.WorkoutSessionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!--
              "specialUse": this FGS only keeps the process alive so the rest-timer alert fires
              reliably during an active workout. It is not a health/sensor service; the "health"
              type additionally requires a runtime health permission we do not hold, which throws
              SecurityException on Android 14+.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the rest timer reliable during an active workout session" />
        </service>

        <!-- Shares exported files (JSON/CSV/PDF) out of app storage via the system share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable default WorkManager auto-init so we can use HiltWorkerFactory (#31). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Today widget (#146) -->
        <receiver
            android:name=".widget.ForgeWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/forge_widget_info" />
        </receiver>
    </application>

</manifest>
