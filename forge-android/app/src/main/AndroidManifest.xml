<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification alert (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service (required API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Foreground service type: specialUse — keeps the rest timer alive during a workout (required API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Timer vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Biometric / device-credential app & gallery lock (GYMAP-69). The androidx.biometric library
         folds in the pre-28 USE_FINGERPRINT alias; no app PIN is stored, the OS owns the credential. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- In-app guided progress-photo camera. Captured shots are written straight to app-private
         storage (never the camera roll); no INTERNET permission, so they never leave the device.
         The camera is optional — the gallery still imports from the photo picker without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Health Connect: read-only recovery signals (sleep, resting HR) feed the coach. These are
         on-device permissions granted via the Health Connect app; Forge holds NO internet permission,
         so the data never leaves the device. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <!-- Bodyweight sync (HC-2/HC-3): read a smart-scale value INTO Forge, write a Forge weigh-in
         BACK. Both opt-in and granted in the Health Connect app; still no internet permission. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <!-- Steps: read a watch/ring's daily step counts INTO Forge for the cardio screen's hourly-steps
         graph. Read-only, opt-in, granted in the Health Connect app; still no internet permission. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Exercise sessions: read a watch's recorded outdoor sessions so Forge can find the GPS route
         that matches a cardio entry. The route data itself is released per-session via Health Connect's
         own consent screen (ExerciseRouteRequestContract) — there is no blanket route-read permission.
         Read-only, opt-in; still no internet permission. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Workout calories (HC-4): write a finished session's estimated active calories OUT to Health
         Connect's daily energy total. Without this the write permission can never be granted. -->
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />

    <!-- W0: write finished gym + cardio sessions to Health Connect (opt-in, Settings → Recovery). -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- W3: the watch's live HR trace attaches to the written session as an HR series. -->
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />

    <!-- W5: read watch workouts' HR series + measured distance/calories (opt-in, Settings → Recovery). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />

    <!-- W6: overnight HRV (readiness input) + the watch's BIA lean-mass reading (opt-in, Recovery). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />

    <!-- Lets us detect / launch the Health Connect provider to check availability + manage grants. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ForgeApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Forge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Forge.Splash">
            <!-- The MAIN/LAUNCHER filter lives on the .icon.* activity-aliases below (selectable app
                 icon), not here, so switching the enabled alias swaps the home-screen icon. -->
            <!-- Health Connect permission rationale (Android 13 and below): HC opens this when the
                 user taps "why does this app want my data". We just bring up Forge. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- Import from another gym app (#GYMAP-17): accept a shared/opened CSV or JSON export so
                 "Export → Share → Avex" imports directly, no file browsing. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

