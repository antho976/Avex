        <service
            android:name=".service.WorkoutSessionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!--
              "specialUse": this FGS only keeps the process alive so the rest-timer alert fires
              reliably during an active workout. It is not a health/sensor service; the "health"
              type additionally requires a runtime health permission we do not hold, which throws
              SecurityException on Android 14+.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the rest timer reliable during an active workout session" />
        </service>

        <!-- W1: the phone's ear for wrist commands. The Data Layer wakes this even when the app
             was killed — commands still land in Room (the plan's phone-in-the-bag guarantee). -->
        <service
            android:name=".service.wear.WearSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/cmd" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/haptic" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hr" />
            </intent-filter>
        </service>

