<!--
    Notification status-bar icon. A silhouette "F" mark on a transparent background, sized to fill
    a 24dp canvas: status-bar small icons are rendered alpha-only (the system tints them), so this
    MUST be a white-on-transparent silhouette — not the colored adaptive-icon foreground (which has
    a 33% safe-zone and would render as a tiny padded blob).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,3 L19,3 L19,7 L9,7 L9,10 L16,10 L16,14 L9,14 L9,21 L5,21 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
