<!--
    Notification status-bar icon. The Avex mark on a transparent background, sized to fill
    a 24dp canvas: status-bar small icons are rendered alpha-only (the system tints them), so this
    MUST be a white-on-transparent silhouette — not the colored adaptive-icon foreground (which has
    a 33% safe-zone and would render as a tiny padded blob).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,3.8 L22,20.2 L2,10.4 L22,10.4 L2,20.2 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
</vector>
