<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Include the main Room DB only — NOT the -wal or -shm sidecars. Restoring a live WAL
            alongside a stale .db file causes Room to see an inconsistent database on first open.
            The -wal and -shm files are ephemeral and must be left to Room to regenerate.
        -->
        <include domain="database" path="forge.db" />
        <exclude domain="database" path="forge.db-wal" />
        <exclude domain="database" path="forge.db-shm" />
        <include domain="sharedpref" path="." />
        <!-- DataStore prefs + progress photos live under files/ — include them so a cloud restore
             brings settings and physique photos back, not just the Room database. -->
        <include domain="file" path="datastore/" />
        <include domain="file" path="progress_photos/" />
        <include domain="file" path="avatar.jpg" />
        <!-- Transient mid-restore staging files (pending_restore.db / _prefs.pb / _photos /
             _avatar.jpg) are deliberately NOT listed above. Because this block uses explicit
             <include> paths, anything not included is already excluded — so no <exclude> is needed,
             and lint (FullBackupContent) rejects excluding a path that isn't under an <include>. -->
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="forge.db" />
        <exclude domain="database" path="forge.db-wal" />
        <exclude domain="database" path="forge.db-shm" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="progress_photos/" />
        <include domain="file" path="avatar.jpg" />
        <!-- pending_restore* staging files are excluded by omission (see the cloud-backup note). -->
    </device-transfer>
</data-extraction-rules>
