<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Include the main Room DB only — NOT the -wal or -shm sidecars. Restoring a live WAL
            alongside a stale .db file causes Room to see an inconsistent database on first open.
            The -wal and -shm files are ephemeral and must be left to Room to regenerate.
        -->
        <include domain="database" path="forge.db" />
        <exclude domain="database" path="forge.db-wal" />
        <exclude domain="database" path="forge.db-shm" />
        <include domain="sharedpref" path="." />
        <!-- DataStore prefs live under files/ — include them so a cloud restore brings settings
             back alongside the Room database. -->
        <include domain="file" path="datastore/" />
        <!--
            progress_photos/ and avatar.jpg are deliberately NOT listed here.

            Cloud backup uploads to the user's Google Drive automatically, with no in-app prompt and
            no per-restore choice. Settings → About tells the user "your data moves only when you
            move it — exports and backups go where you point them, through Android's own picker",
            and progress photos are the most sensitive thing this app holds. Shipping them off the
            device by default contradicts that promise.

            They stay in <device-transfer> below, which only runs when the user actively migrates to
            a new phone — that IS them moving it. A user who wants photos in the cloud can take a
            backup through the in-app export, which is the "where you point them" path.
        -->
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="forge.db" />
        <exclude domain="database" path="forge.db-wal" />
        <exclude domain="database" path="forge.db-shm" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="progress_photos/" />
        <include domain="file" path="avatar.jpg" />
        <!-- pending_restore* staging files are excluded by omission (see the cloud-backup note). -->
    </device-transfer>
</data-extraction-rules>
