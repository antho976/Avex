# Copy this file to "keystore.properties" (same folder, forge-android/) and fill in real values.
# keystore.properties is gitignored — NEVER commit it, and never commit the .jks file either.
#
# 1) Use the upload key already registered for Avex in Play Console. Do not generate a replacement
#    key for an existing listing. Only a first-ever release should create a new upload key:
#
#      keytool -genkeypair -v -keystore avex-upload.jks -keyalg RSA -keysize 2048 \
#              -validity 10000 -alias avex-upload
#
#    (On Windows, keytool lives in the JDK/JBR bin folder, e.g. Android Studio's jbr\bin\keytool.exe)
#
# 2) Point storeFile at that .jks (path relative to forge-android/, or an absolute path).
# 3) Fill in the alias + the two passwords you chose during generation.
#
# When keystore.properties is absent, the release build is left unsigned and debug builds are
# unaffected — so the project still builds fine on a machine that hasn't set this up.

storeFile=avex-upload.jks
storePassword=CHANGE_ME
keyAlias=avex-upload
keyPassword=CHANGE_ME
