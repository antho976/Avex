<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Wrist haptics: timer-done buzz, set-logged tick, PR double-tick. Nothing else vibrates. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- OngoingActivity's session chip rides a notification (runtime-granted on Wear 4+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live HR via Health Services during sessions (W3) — runtime-granted, works-without state.
         Declared for two permission eras, because targetSdk is 36 and the module used to declare
         only the first:
           • BODY_SENSORS is what the platform enforces for HEART_RATE_BPM up to API 35. Capped
             there so a watch on 36+ is never asked for a permission it can no longer grant.
           • android.permission.health.READ_HEART_RATE replaces it from API 36. Without this, an
             API 36 watch starts the exercise and receives no heart rate at all — the failure is a
             silently empty metric, not an error, so nothing in the app notices.
         Requested version-gated at runtime; see WearHealthPermissions. -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- CALORIES_TOTAL is activity-derived, not a sensor read, and Health Services enforces
         ACTIVITY_RECOGNITION for it on every API level. The exercise config has always asked for
         it; without this permission the calorie half of every HR batch is quietly absent, and the
         phone falls back to its MET estimate believing the watch simply had nothing to say.

         No background health permission is declared on purpose. BODY_SENSORS_BACKGROUND (33–35) and
         READ_HEALTH_DATA_IN_BACKGROUND (36) cover reading sensors while the app is in the
         background; this app only ever reads inside a type="health" foreground service, which is
         while-in-use. Adding one would widen the Play health-data declaration for access the app
         does not take. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- No INTERNET permission — the Data Layer is Bluetooth IPC; nothing leaves the wrist. -->

    <application
        android:name=".WearApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AvexWear">

        <!-- Companion app: requires the phone app; never listed as standalone. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />
        <!-- The phone's notifications stop auto-bridging: the watch has native surfaces now, so a
             bridged duplicate of the timer alert would double-buzz (one alert, one body part). -->
        <meta-data
            android:name="com.google.android.wearable.notificationBridgeMode"
            android:value="NO_BRIDGING" />
        <meta-data
            android:name="com.google.android.wearable.watch_type"
            android:value="round" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AvexWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wakes the watch app when the phone publishes state while it isn't foreground
             (tile refresh W4; config/session updates). -->
        <service
            android:name=".service.WearDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/" />
            </intent-filter>
        </service>

        <!-- W3: holds the Health Services exercise (live HR + calories) while a session is live. -->
        <service
            android:name=".service.WearHrService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- W4: the swipe-right glances, rendered from /glance/today. -->
        <service
            android:name=".glance.TodayTileService"
            android:exported="true"
            android:label="Avex today"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>
        <service
            android:name=".glance.WeekTileService"
            android:exported="true"
            android:label="Avex week"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- W4: watch-face complications — readiness, next session, active rest timer. -->
        <service
            android:name=".glance.ReadinessComplicationService"
            android:exported="true"
            android:label="Avex readiness"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>
        <service
            android:name=".glance.NextSessionComplicationService"
            android:exported="true"
            android:label="Avex next session"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>
        <service
            android:name=".glance.RestTimerComplicationService"
            android:exported="true"
            android:label="Avex rest timer"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- The wear app capability the phone checks reachability against (WearProtocol). -->
    </application>
</manifest>
